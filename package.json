{
  "name": "anisocial-desktop",
  "version": "0.3.0",
  "description": "Desktop-App für AniSocial.de – Die Anime-Community",
  "main": "dist/main.js",
  "scripts": {
    "compile": "tsc",
    "prestart": "tsc",
    "start": "electron .",
    "dev": "concurrently -k \"tsc --watch --preserveWatchOutput\" \"electron .\"",
    "build": "tsc && electron-builder",
    "build:linux": "tsc && electron-builder --linux",
    "build:win": "tsc && electron-builder --win",
    "build:mac": "tsc && electron-builder --mac",
    "lint": "eslint src/",
    "test": "vitest run",
    "test:watch": "vitest",
    "format": "prettier --write src/",
    "format:check": "prettier --check src/"
  },
  "author": {
    "name": "Vando",
    "email": "vando.02800@tutamail.com"
  },
  "license": "MIT",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^25.8.0",
    "concurrently": "^9.2.1",
    "electron": "^42.1.0",
    "electron-builder": "^26.0.0",
    "electron-reloader": "^1.2.3",
    "eslint": "^10.4.0",
    "prettier": "^3.8.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.59.3",
    "vitest": "^4.1.6"
  },
  "dependencies": {
    "electron-updater": "^6.8.3",
    "electron-window-state": "^5.0.3"
  },
  "build": {
    "appId": "de.anisocial.desktop",
    "productName": "AniSocial",
    "publish": {
      "provider": "github",
      "owner": "VandoOmi",
      "repo": "AniSocialDesktop"
    },
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**",
      "assets/**"
    ],
    "linux": {
      "target": [
        "AppImage",
        "deb",
        "rpm",
        "pacman",
        "tar.gz"
      ],
      "icon": "assets/icon.png",
      "category": "Network"
    },
    "win": {
      "target": "nsis",
      "icon": "assets/icon.ico"
    },
    "mac": {
      "target": "dmg",
      "icon": "assets/icon.png"
    }
  }
}
