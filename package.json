{
  "name": "anisocial-desktop",
  "version": "0.2.1",
  "description": "Desktop-App für AniSocial.de – Die Anime-Community",
  "main": "dist/main.js",
  "scripts": {
    "compile": "tsc",
    "prestart": "tsc",
    "start": "electron .",
    "dev": "tsc && electron .",
    "build": "tsc && electron-builder",
    "build:linux": "tsc && electron-builder --linux",
    "build:win": "tsc && electron-builder --win",
    "build:mac": "tsc && electron-builder --mac",
    "lint": "eslint src/",
    "format": "prettier --write src/",
    "format:check": "prettier --check src/"
  },
  "author": {
    "name": "Vando",
    "email": "vando.02800@tutamail.com"
  },
  "license": "MIT",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/discord-rpc": "^4.0.10",
    "@types/node": "^25.8.0",
    "electron": "^42.1.0",
    "electron-builder": "^26.0.0",
    "eslint": "^10.4.0",
    "prettier": "^3.8.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.59.3"
  },
  "dependencies": {
    "discord-rpc": "^4.0.1",
    "electron-updater": "^6.8.3",
    "electron-window-state": "^5.0.3"
  },
  "build": {
    "appId": "de.anisocial.desktop",
    "productName": "AniSocial",
    "publish": {
      "provider": "github",
      "owner": "VandoOmi",
      "repo": "AniSocialDesktop"
    },
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**",
      "assets/**"
    ],
    "linux": {
      "target": [
        "AppImage",
        "deb",
        "rpm",
        "pacman",
        "tar.gz"
      ],
      "icon": "assets/icon.png",
      "category": "Network",
      "mimeTypes": [
        "x-scheme-handler/anisocial"
      ]
    },
    "win": {
      "target": "nsis",
      "icon": "assets/icon.ico"
    },
    "mac": {
      "target": "dmg",
      "icon": "assets/icon.png",
      "protocols": [
        {
          "name": "AniSocial",
          "schemes": [
            "anisocial"
          ]
        }
      ]
    }
  }
}
